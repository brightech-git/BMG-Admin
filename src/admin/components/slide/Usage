import { useLocation } from 'react-router-dom';
import {
    getBreadcrumbs,
    getPageTitle,
    getTableRows,
    filterMenuByRole,
    MENU_CONFIG,
} from '../utils/menuConfig';


// ── 1. BREADCRUMB COMPONENT ──────────────────────────────────────────────────
// Drop this anywhere in your layout.
export const Breadcrumb = () => {
    const { pathname } = useLocation();
    const crumbs = getBreadcrumbs(pathname);
    // e.g. pathname = '/admin/banner/setting/add'
    // crumbs = [
    //   { id:'settings',        title:'Settings',           path: undefined },
    //   { id:'settings-banner', title:'Banner Settings',    path: undefined },
    //   { id:'banner-setting-add', title:'Add Banner Setting', path:'/admin/banner/setting/add' },
    // ]

    if (!crumbs.length) return null;

    return (
        <nav className="flex items-center gap-1.5 text-sm text-gray-500">
            <span className="text-gray-400">Admin</span>
            {crumbs.map((c, i) => (
                <span key={c.id} className="flex items-center gap-1.5">
                    <span className="text-gray-300">/</span>
                    {i === crumbs.length - 1 ? (
                        <span className="font-semibold text-orange-500">{c.title}</span>
                    ) : (
                        <span>{c.title}</span>
                    )}
                </span>
            ))}
        </nav>
    );
};


// ── 2. PAGE TITLE ────────────────────────────────────────────────────────────
// In your top layout / header:
//
//   const title = getPageTitle(location.pathname);
//   // → 'Pending Orders'  for  /admin/order/status/PENDING
//   // → 'Add Employee'    for  /admin/employee/add


// ── 3. MENU MANAGEMENT TABLE ─────────────────────────────────────────────────
// Render all menu rows in an admin settings table.
export const MenuTable = () => {
    const rows = getTableRows();
    // Each row:  { id, name, path, tier, parentTitle, roles }
    // e.g.
    // { id:'orders',        name:'Orders',         path:'—',                            tier:1, parentTitle:'—',      roles:[] }
    // { id:'order-pending', name:'Pending',         path:'/admin/order/status/PENDING',  tier:2, parentTitle:'Orders', roles:[] }
    // { id:'settings',      name:'Settings',        path:'—',                            tier:1, parentTitle:'—',      roles:[] }
    // { id:'settings-banner',name:'Banner Settings',path:'—',                            tier:2, parentTitle:'Settings',roles:[] }
    // { id:'banner-setting-add',name:'Add Banner Setting',path:'/admin/banner/setting/add',tier:3,parentTitle:'Banner Settings',roles:[] }

    return (
        <table className="w-full text-sm border-collapse">
            <thead>
                <tr className="bg-orange-50 text-left">
                    <th className="px-4 py-2 font-semibold">Name</th>
                    <th className="px-4 py-2 font-semibold">Path</th>
                    <th className="px-4 py-2 font-semibold">Tier</th>
                    <th className="px-4 py-2 font-semibold">Parent</th>
                    <th className="px-4 py-2 font-semibold">Roles</th>
                </tr>
            </thead>
            <tbody>
                {rows.map((row) => (
                    <tr key={row.id} className="border-t hover:bg-gray-50">
                        <td className="px-4 py-2" style={{ paddingLeft: `${(row.tier - 1) * 20 + 16}px` }}>
                            {row.name}
                        </td>
                        <td className="px-4 py-2 font-mono text-xs text-gray-500">{row.path}</td>
                        <td className="px-4 py-2">
                            <span className="px-2 py-0.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-600">
                                Tier {row.tier}
                            </span>
                        </td>
                        <td className="px-4 py-2 text-gray-500">{row.parentTitle}</td>
                        <td className="px-4 py-2 text-gray-500">
                            {row.roles.length ? row.roles.join(', ') : 'All'}
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    );
};


// ── 4. ROLE FILTERING ────────────────────────────────────────────────────────
